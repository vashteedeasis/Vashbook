
---
const { frontmatter } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | Vashtee's Blog</title>
  </head>
  <body>
    <nav>
      <a href="/">← Back to Home</a>
      <a href="/thoughts">All Thoughts</a>
    </nav>

    <main>
      <h1>{frontmatter.title}</h1>
      {frontmatter.pubDate && (
        <p>{new Date(frontmatter.pubDate).toLocaleDateString()}</p>
      )}
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    max-width: 800px;
    margin: 0 auto;
    padding: 32px 24px;
    font-family: Arial, sans-serif;
    line-height: 1.7;
  }

  nav {
    display: flex;
    gap: 24px;
    margin-bottom: 40px;
  }

  nav a {
    color: #7c3aed;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }
</style>
